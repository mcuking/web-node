{
  "name": "web-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run Node.js source in the browser (WebContainer-style runtime).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "vendor": "node tools/vendor.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
